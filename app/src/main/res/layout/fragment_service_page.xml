<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/background"
    tools:context=".view.fragment.main.ServicePageFragment">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true"
            android:background="?attr/background"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:layout_width="match_parent"
                android:layout_height="400dp"
                app:contentScrim="?attr/background"
                app:scrimAnimationDuration="250"
                app:scrimVisibleHeightTrigger="150dp"
                app:layout_scrollFlags="scroll|snap|enterAlwaysCollapsed|exitUntilCollapsed"
                app:toolbarId="@id/service_page_toolbar">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="70dp"
                    app:layout_collapseMode="parallax"
                    app:layout_collapseParallaxMultiplier="0.5">

                    <ImageView
                        android:id="@+id/service_page_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:cropToPadding="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/abstract_bg"
                        android:visibility="visible" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/service_page_toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    app:layout_collapseMode="pin"
                    android:layout_gravity="bottom"
                    app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="16dp">

                        <TextView
                            android:id="@+id/service_page_category"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="1dp"
                            android:includeFontPadding="false"
                            android:text="@string/service_category"
                            android:textColor="?attr/colorAccent"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toTopOf="@+id/service_page_title"
                            app:layout_constraintStart_toStartOf="@+id/service_page_title"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.86" />

                        <TextView
                            android:id="@+id/service_page_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginStart="5dp"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:letterSpacing="-0.01"
                            android:maxLines="1"
                            android:text="Tên dịch vụ sẽ hiển thị ở đây"
                            android:textColor="?attr/textFillColor"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/service_page_back"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.75" />

                        <ImageButton
                            android:id="@+id/service_page_back"
                            android:layout_width="25dp"
                            android:layout_height="40dp"
                            android:adjustViewBounds="true"
                            android:background="@drawable/borderless_ripple"
                            android:cropToPadding="true"
                            android:scaleType="centerCrop"
                            app:layout_constraintBottom_toBottomOf="@+id/service_page_title"
                            app:layout_constraintEnd_toStartOf="@+id/service_page_title"
                            app:layout_constraintHorizontal_bias="0.0"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/service_page_category"
                            app:srcCompat="@drawable/ic_round_arrow_back_ios_new_24"
                            app:tint="?attr/textFillColor" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.appcompat.widget.Toolbar>

            </com.google.android.material.appbar.CollapsingToolbarLayout>

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/service_nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:fadingEdgeLength="15dp"
            android:overScrollMode="never"
            android:requiresFadingEdge="vertical"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/service_page_main_info_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/service_page_base_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Giá cơ bản: 0 VNĐ"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/service_page_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Khu vực: TP. Hồ Chí Minh, Quận 1"
                        android:textSize="16sp"
                        android:textColor="?attr/textFillColor"
                        app:layout_constraintTop_toBottomOf="@id/service_page_base_price"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/service_page_estimated_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thời gian ước tính: 1 - 5 ngày"
                        android:textSize="16sp"
                        android:textColor="?attr/textFillColor"
                        app:layout_constraintTop_toBottomOf="@id/service_page_location"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/service_rating_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:id="@+id/service_rating_star_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:id="@+id/service_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorAccent" />

                        <TextView
                            android:id="@+id/service_star_symbol"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="★"
                            android:textSize="18sp"
                            android:textColor="?attr/colorAccent"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/service_review_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(0 đánh giá)"
                        android:textSize="14sp"
                        android:textColor="?attr/textFillColor"
                        android:layout_marginStart="8dp"
                        app:layout_constraintStart_toEndOf="@+id/service_rating_star_layout"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/service_used_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/_0_l_t_s_d_ng"
                        android:textSize="14sp"
                        android:textColor="?attr/textFillColor"
                        android:layout_marginStart="16dp"
                        app:layout_constraintStart_toEndOf="@+id/service_review_count"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/service_page_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="@font/raleway_light"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:text="@string/m_t_d_ch_v_s_hi_n_th_y"
                    android:textColor="?attr/textFillColor"
                    android:textSize="20sp"/>

                <TextView
                    android:id="@+id/service_detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/c_c_lo_i_ph_ng_d_ch_v_cho_th_c_ng"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textAlignment="textStart" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/service_detail_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:overScrollMode="never" />

                <TextView
                    android:id="@+id/service_step_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Các bước thực hiện dịch vụ"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textAlignment="textStart" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/service_step_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:overScrollMode="never" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/service_page_loadingPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/background"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:id="@+id/service_progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:indeterminate="true"
            android:indeterminateTint="?attr/colorPrimary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout> 