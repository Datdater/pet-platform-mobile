<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chỉnh sửa thú cưng"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_gravity="center_horizontal"
        android:paddingBottom="12dp" />

    <EditText
        android:id="@+id/edtPetName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tên thú cưng" />

    <EditText
        android:id="@+id/edtPetDob"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ngày sinh (YYYY-MM-DD)"
        android:inputType="date" />

    <EditText
        android:id="@+id/edtPetWeight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Cân nặng (kg)"
        android:inputType="numberDecimal" />

    <Spinner
        android:id="@+id/spinnerPetType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:entries="@array/pet_type_array" />

    <EditText
        android:id="@+id/edtPetColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Màu sắc" />

    <EditText
        android:id="@+id/edtSpecialRequirement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Yêu cầu đặc biệt (tùy chọn)" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hủy" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lưu"
            android:layout_marginStart="16dp" />
    </LinearLayout>
</LinearLayout> 