<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <TextView
        android:id="@+id/service_step_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Bước 1: Tiếp nhận và kiểm tra sức khỏe"
        android:textStyle="bold"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/service_step_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Mô tả bước dịch vụ sẽ hiển thị ở đây"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/service_step_name"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

</androidx.constraintlayout.widget.ConstraintLayout> 